# VentureSwarm Environment Variables (Optional)
# If left blank, the platform runs in Autonomous Heuristic Mode with live DuckDuckGo web scraping!

# Google Gemini API Key (Recommended: gemini-3.8-flash)
GEMINI_API_KEY=

# OpenAI API Key (Alternative: gpt-4o)
OPENAI_API_KEY=

# Firecrawl API Key (Optional: for deep markdown scraping fallback)
FIRECRAWL_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1
